DATABASE_URL=postgres://fitcore:fitcore@localhost:5432/fitcore
CORE_URL=http://localhost:3000
# Misma clave y organización que services/core
SERVICE_KEY=cambia-esto
SERVICE_ORG_SLUG=fitcore-demo
# Plan gratuito de Gemini: Google puede usar lo que se envía; solo datos ficticios.
GEMINI_API_KEY=
# Valida los IDs con models.list antes de fijarlos.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Segundo modelo si el primero falla (opcional, otro proveedor requiere su propia clave)
LLM_FALLBACK_MODEL=
EMBED_MODEL=gemini/gemini-embedding-2
# Mensajes de usuario por contacto y día (protege la cuota gratuita)
DAILY_LIMIT=30
RAG_MIN_SCORE=0.3
GYM_TZ=America/Mexico_City
# Orígenes permitidos para el chat web, separados por coma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4321
# WhatsApp Cloud API (vacíos en local: la respuesta solo se registra en el log)
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_TOKEN=
WA_PHONE_ID=
# Solo desarrollo: acepta el webhook sin firma
WA_SKIP_SIGNATURE=

# Chat web de la demo (widget). CHAT_TOKEN_SECRET debe ser la misma que en el núcleo: openssl rand -hex 32
CHAT_TOKEN_SECRET=dev-chat-secret-dev-chat-secret
# Socio sembrado al que se asocia el invitado (lo crea el seed)
DEMO_MEMBER_PHONE=+525500000000
# Tope de mensajes web por día en total (protege la cuota del LLM) y rechazos fuera de tema seguidos antes de cortar la sesión
GLOBAL_DAILY_LIMIT=400
OFF_TOPIC_MAX=3
# Solo pruebas e2e: LLM determinista sin red
# LLM_FAKE=1
