# Núcleo al que se reporta el aforo (la misma clave que SERVICE_KEY de services/core)
CORE_URL=http://localhost:3000
SERVICE_KEY=dev-service-key
# Nombre de la cámara tal como aparecerá en los registros
CAMERA_NAME=sala-principal
# OBLIGATORIA: ruta de un video (mp4/avi) o el índice de la webcam (0, 1…).
# Usa un video propio con consentimiento de quienes aparecen, o la webcam.
VIDEO_SOURCE=
# Fotogramas analizados por segundo y segundos entre reportes
SAMPLE_FPS=1
REPORT_EVERY=60
# Confianza mínima para contar una persona. Más bajo cuenta más personas lejanas pero admite más falsos positivos: calíbralo con tu video.
SCORE_THRESHOLD=0.35
# 1 = repite el archivo al llegar al final (simula una cámara continua)
LOOP=1
